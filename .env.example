# Amazonアソシエイト・トラッキングID(例: yourtag-22)
# 設定すると商品リンクに自動で付与される。未設定でも検索リンクとして動作する。
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# 楽天アフィリエイトID(例: 1a2b3c4d.5e6f7g8h)
# 設定すると楽天アフィリエイトのリンク変換経由になる。未設定でも検索リンクとして動作する。
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=

# Google Analytics 4 の測定ID(例: G-XXXXXXXXXX)
# 未設定の場合はAnalyticsを読み込まない。
NEXT_PUBLIC_GA_ID=

# Google Search Console のHTMLタグ確認コード(コンテンツ値のみ、例: abcd1234...)
# 未設定の場合はメタタグを出力しない。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# サイトの本番URL(サイトマップ・OGP・canonicalに使用)
NEXT_PUBLIC_SITE_URL=https://fes-tools-app.vercel.app

# お問い合わせページに表示する連絡先メールアドレス
# 未設定の場合は「準備中」の案内を表示する
NEXT_PUBLIC_CONTACT_EMAIL=
